# /etc/systemd/system/mss-clamp.service
#
# Works on Ubuntu 22.04
#
# Fix stalled downloads in Docker containers when on a VPN (e.g. Surfshark
# WireGuard, tunnel MTU 1280).
#
# Containers use MTU 1500 and advertise a large TCP MSS. Full-size reply
# packets don't fit the tunnel, and the ICMP "fragmentation needed" messages
# that should shrink them get lost (PMTUD black hole). TCP connects, then
# hangs on data transfer (apt "Connection failed", npm/composer timeouts).
#
# This rewrites the MSS on forwarded TCP SYNs to fit the outgoing route's MTU.
# It does nothing when the route MTU is 1500 (VPN off), so it's safe to leave
# enabled. The host's own traffic doesn't need it because the kernel already
# sizes those packets for the route.
#
# Verify (with VPN on):
#   docker run --rm alpine wget -q -T 15 -O /dev/null \
#     http://archive.ubuntu.com/ubuntu/dists/noble/InRelease && echo OK
[Unit]
Description=Clamp TCP MSS on forwarded traffic to path MTU (Docker over VPN)
After=docker.service ufw.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -t mangle -C FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || iptables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu'
ExecStop=/usr/sbin/iptables -t mangle -D FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu

[Install]
WantedBy=multi-user.target
