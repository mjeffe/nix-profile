# Shared git settings: behavior, aliases, default identity.
#
# Installed as: nothing. This file stays in the clone and is not copied or
#   renamed. ~/.gitconfig loads it by path, from its first lines:
#       [include]
#           path = ~/src/mrj/nix-profile/git/gitconfig
#   so a `git pull` in the clone updates every machine.
#
# Keep client names, credential helpers, and anything private out of this
# public file. They go in ~/.gitconfig or ~/src/<client>/.gitconfig, which
# come after this include and override it.

[push]
	default = simple
[pull]
	rebase = true
	stat = true
[alias]
	# simple log 
	slog = log --decorate --oneline
	# full log
	flog = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ad)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --full-history --sparse --date=local
	# who log
	wlog = log --pretty=format:"%h%x09%an%x09%ad%x09%s" --date=local 
	# history log
	hlog = log --stat -p
	# history follow log (follows renames, deletes, etc)
	fhlog = log --oneline --find-renames --stat --follow
[remote "origin"]
	prune = true
[fetch]
	prune = true
[merge]
	stat = true
[core]
	excludesfile = ~/.gitignore_global
[diff]
	colorMoved = zebra
	tool = mycustomdiff
[difftool "mycustomdiff"]
	# side-by-side diff; or use a built-in tool, e.g. git difftool -t vimdiff
	cmd = sdiff -w200 \"$LOCAL\" \"$REMOTE\" | less
[difftool]
	prompt = false

# Default identity. Each client directory overrides it (see client.gitconfig.example).
[user]
	email = matt@mattjeffery.dev
	name = Matt Jeffery

# Clone my repos anonymously over HTTPS (works before any ssh key exists on a
# new box), but push over ssh.
[url "git@github.com:mjeffe/"]
	pushInsteadOf = https://github.com/mjeffe/

# My own projects. Relative paths resolve next to this file.
[includeIf "gitdir:~/src/mrj/"]
	path = gitconfig-mrj

[init]
	defaultBranch = main
