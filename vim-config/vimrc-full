" --------------------------------------------------------------------------------
" Matt's .vimrc
"
" Dual-mode config: plain vim for normal editing, IDE mode with plugins.
" Add this alias to your ~/.bashrc:
"   alias vide='VIM_IDE=1 vim'
"
" Then invoke `vim` for normal use, or `vide` for IDE mode with plugins.
" Works in Neovim too: install init.vim as ~/.config/nvim/init.vim, and
" `VIM_IDE=1 nvim` uses the same plugins.
"
" Setup on a new system:
"   curl -fLo ~/.vim/autoload/plug.vim --create-dirs \
"     https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
"   mkdir -p ~/.vim/{swap,backup}
"   cp .vim/colors/mrj.vim ~/.vim/colors/
"   vide +PlugInstall +qall
"
" See :help mrj for notes on this setup.
" --------------------------------------------------------------------------------

set nocompatible
filetype off

" --- IDE mode (plugins via vim-plug) ------------------------------------------

if $VIM_IDE == '1'
    call plug#begin('~/.vim/plugged')

    " file tree browser
    Plug 'preservim/nerdtree'

    " language error checking
    Plug 'vim-syntastic/syntastic'

    " fuzzy file finder (Ctrl-P)
    Plug 'ctrlpvim/ctrlp.vim'

    " ctags management (auto-generates tags on save)
    " requires: sudo apt install exuberant-ctags
    Plug 'ludovicchabant/vim-gutentags'

    " Vue.js syntax highlighting (supports Vue 2/3, TypeScript, scss, etc.)
    Plug 'leafOfTree/vim-vue-plugin'

    " AWS CloudFormation syntax checking and highlighting
    " https://github.com/aws-cloudformation/cfn-lint
    Plug 'speshak/vim-cfn'

    " Rainbow CSV - aids working with csv files
    Plug 'mechatroner/rainbow_csv'

    call plug#end()
    filetype plugin indent on


    " --- Plugin-specific settings ---------------------------------------------

    " ----- NERDTree -----
    " One tree shared by every tab and toggled in all tabs together, the way
    " the abandoned vim-nerdtree-tabs plugin worked.
    let NERDTreeShowBookmarks = 1
    let g:mrj_nerdtree_on = 0

    function! s:NERDTreeShow() abort
        if g:NERDTree.IsOpen()
            return
        endif
        silent! NERDTreeMirror
        if !g:NERDTree.IsOpen()
            NERDTree
        endif
        wincmd p
    endfunction

    function! s:NERDTreeToggleAllTabs() abort
        let g:mrj_nerdtree_on = !g:NERDTree.IsOpen()
        let l:tab = tabpagenr()
        if g:mrj_nerdtree_on
            tabdo call s:NERDTreeShow()
        else
            tabdo NERDTreeClose
        endif
        execute l:tab . 'tabnext'
    endfunction

    augroup mrjNERDTree
        au!
        " new tabs get the tree while it is on
        au TabNew * if g:mrj_nerdtree_on | call timer_start(0, {-> s:NERDTreeShow()}) | endif
        " close a tab, or vim, when the tree is the last window left
        " (feedkeys: newer vim refuses to close windows from inside an autocmd)
        au BufEnter * if winnr('$') == 1 && exists('b:NERDTree') && b:NERDTree.isTabTree()
                    \ | call feedkeys(":quit\<CR>:\<BS>") | endif
    augroup END

    nnoremap <silent> <C-n> :call <SID>NERDTreeToggleAllTabs()<CR>
    nnoremap <silent> <leader>t :call <SID>NERDTreeToggleAllTabs()<CR>

    " ----- syntastic -----
    let g:syntastic_error_symbol = '✘'
    let g:syntastic_warning_symbol = "▲"
    augroup mySyntastic
        au!
        au FileType tex let b:syntastic_mode = "passive"
    augroup END

    let g:syntastic_always_populate_loc_list = 1
    let g:syntastic_auto_loc_list = 1
    let g:syntastic_check_on_open = 1
    let g:syntastic_check_on_wq = 0

    let g:syntastic_perl_checkers = ['perl']
    let g:syntastic_enable_perl_checker = 1

    let g:syntastic_python_python_exec = 'python3'
    let g:syntastic_python_checkers = ['python']

    let g:syntastic_html_tidy_quiet_messages = { "level" : "warnings" }

    " ----- ctrlp -----
    " To clear the ctrlp cache, invoke CtrlP, then hit <F5>
    let g:ctrlp_match_window = 'order:ttb,min:1,max:30,results:30'
    let g:ctrlp_working_path_mode = 'ra'    " 'ra' - search from project root, 'c' from current dir
    let g:ctrlp_by_filename = 1             " search by filename = 1, by full path = 0
    let g:ctrlp_regexp = 1                  " regexp search by default; toggle with <c-r> in the prompt
    let g:ctrlp_custom_ignore = {
      \ 'dir':  '\.git$\|\.svn$\|node_modules$\|vendor$\|log$\|tmp$',
      \ 'file': '\.exe$\|\.so$\|\.dat$\|\.jpg$\|\.jpeg$\|\.png\|\.pdf$'
      \ }

    " ----- gutentags -----
    " big help from: https://www.reddit.com/r/vim/comments/d77t6j/guide_how_to_setup_ctags_with_gutentags_properly/
    let g:gutentags_generate_on_new = 1
    let g:gutentags_generate_on_missing = 1
    let g:gutentags_generate_on_write = 1
    let g:gutentags_generate_on_empty_buffer = 0
    let g:gutentags_project_root = ['package.json']
    let g:gutentags_cache_dir = expand('~/.cache/vim/ctags/')
    let g:gutentags_ctags_extra_args = [
        \ '--tag-relative=yes',
        \ '--fields=+ailmnS',
        \ ]
    let g:gutentags_ctags_exclude = [
        \ 'tmp/*', 'log/*', 'coverage/*',
        \ '*.git', '*.svg', '*.hg',
        \ 'build', 'dist', 'bin',
        \ '*sites/*/files/*',
        \ 'node_modules', 'bower_components',
        \ 'cache', 'compiled', 'bundle', 'vendor',
        \ 'docs', 'doc/*', 'example',
        \ '*.md', '*-lock.json', '*.lock',
        \ '*bundle*.js', '*build*.js', '.*rc*',
        \ '*.json', '*.min.*', '*.map',
        \ '*.bak', '*.zip', '*.pyc', '*.class',
        \ '*.sln', '*.Master', '*.csproj', '*.tmp',
        \ '*.csproj.user', '*.cache', '*.pdb',
        \ 'tags*', 'cscope.*',
        \ '*.css', '*.less', '*.scss',
        \ '*.exe', '*.dll',
        \ '*.mp3', '*.ogg', '*.flac',
        \ '*.swp', '*.swo',
        \ '*.bmp', '*.gif', '*.ico', '*.jpg', '*.png',
        \ '*.rar', '*.zip', '*.tar', '*.tar.gz', '*.tar.xz', '*.tar.bz2',
        \ '*.pdf', '*.doc', '*.docx', '*.ppt', '*.pptx',
        \ ]

    " --- IDE-only general settings ---
    set number

    " mouse: on Linux (and Mac with iTerm2) mouse=a works; hold SHIFT for the
    " terminal's own copy/paste. In Mac Terminal try mouse=r instead.
    set mouse=a

    " F6 to toggle line numbers + NERDTree (for copy/paste of multiline text)
    nnoremap <silent> <F6> :set number!<CR>:call <SID>NERDTreeToggleAllTabs()<CR>
endif

" --- General settings ---------------------------------------------------------

filetype plugin indent on
set backspace=indent,eol,start
set ruler
set showcmd
set showmode
set incsearch

" display tabs and trailing spaces
set list
set listchars=tab:▷⋅,trail:⋅,nbsp:⋅

" indentation
set shiftwidth=4
set tabstop=4
set expandtab

if has('nvim')
    " mrj.vim defines terminal colors only; don't let Neovim switch to GUI colors
    set notermguicolors
else
    " Neovim has these as defaults or no longer supports them
    set encoding=utf-8
    set pastetoggle=<F12>
    if exists('+cryptmethod')
        set cryptmethod=blowfish2       " for files encrypted with :X
    endif
    silent! packadd! matchit            " allow % to match html/xml tags
    " put swap/backup files under ~/.vim (Neovim keeps its own under ~/.local/state/nvim)
    set backupdir=~/.vim/backup//
    set directory=~/.vim/swap//
endif

" syntax and colors
colorscheme mrj
syntax on
hi clear SignColumn
let g:loaded_matchparen=1
if isdirectory(expand('~/.vim/doc'))
    helptags ~/.vim/doc
endif

" folding (see :help mrj)
set foldmethod=syntax
set foldnestmax=20
set foldlevel=1
set foldlevelstart=99

" jump to last position when reopening a file
au BufReadPost * if line("'\"") > 0 && line("'\"") <= line("$") | exe "normal g'\"" | endif

" grep word under cursor with F4, navigate results with :cn (next) and :cp (prev)
map <F4> :execute " grep -srnw --binary-files=without-match --exclude-dir=.git --exclude-dir=node_modules --exclude-dir=vendor --exclude-dir=dist --exclude-dir=build --exclude='*.min.*' --exclude='*.map' --exclude='*.swp' --exclude='*~' . -e " . expand("<cword>") . " " <bar> cwindow<CR>

" commands for soft wrapping long lines: :Wrap and :NoWrap
" source: http://vimcasts.org/episodes/soft-wrapping-text/
command! -nargs=* Wrap set wrap linebreak nolist showbreak=…
command! -nargs=* NoWrap set nowrap nolinebreak

" python3
let g:pymode_python = 'python3'

" php folding
let g:php_folding=2

" insert sequence number column: select lines with V, then
"   :let i=1 | '<,'>g/^/ s//\=i . " "/ | let i+=1

" --- FileType-specific settings -----------------------------------------------
" Also see files in ~/.vim/after/ftplugin/

" custom filetype detection
au BufNewFile,BufRead *.edi,*.x12 setf x12

au! FileType c,sql set formatoptions+=ro
au FileType make set noexpandtab shiftwidth=8 tabstop=8

" --- Accent toggle (mapped to '-' key) ----------------------------------------

function! ToggleAccent()
    let withAccent   = [ "á", "é", "í", "ó", "ú", "ñ", "Á", "É", "Í", "Ó", "Ú", "Ñ" ]
    let withNoAccent = [ "a", "e", "i", "o", "u", "n", "A", "E", "I", "O", "U", "N" ]
    let character = matchstr( getline('.'), '\%' . col('.') . 'c.' )
    let position = match( withNoAccent , character )
    if position != -1
        execute ":normal! r" . withAccent[position]
    else
        let position = match( withAccent , character )
        if position != -1
            execute ":normal! r" . withNoAccent[position]
        endif
    endif
endfunction
nnoremap <silent> - :call ToggleAccent()<CR>

" --- Spell checking -----------------------------------------------------------

set spelllang=en_us
if isdirectory(expand('~/Dropbox/vim/spell'))
    set spellfile=~/Dropbox/vim/spell/en.utf-8.add
endif
autocmd filetype svn,*commit* setlocal spell
autocmd filetype git,*commit* setlocal spell

" source project-specific config files
runtime! projects/**/*.vim
